{
  "name": "openms.dev",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "content",
    "studio"
  ],
  "scripts": {
    "extract": "bun tools/openms.js extract",
    "migrate": "bun tools/migrate.js",
    "server:dev": "bun server/tools/dev.js",
    "server:prod": "NODE_ENV=production bun server/src/index.js",
    "client:dev": "bun client/tools/dev-online.js",
    "client:prod": "bun client/tools/prod-online.js",
    "playtest": "bun server/tools/playtest.js",
    "dev:docs": "bunx --bun vitepress dev docs",
    "docs:check": "bun docs/tools/check.js",
    "docs:build": "bunx --bun vitepress build docs",
    "docs:preview": "bunx --bun vitepress preview docs",
    "test": "bun test",
    "test:content": "bun test content/test server/test/content-http.test.js server/test/world-content.test.js",
    "check:content": "bun server/tools/check-content.js",
    "studio:build": "bun studio/tools/build.js",
    "studio:dev": "bun studio/tools/dev.js",
    "studio:start": "bun studio/tools/dev.js",
    "check:studio": "bun server/tools/check-studio.js",
    "lint": "bunx --bun eslint . --max-warnings 0",
    "format": "bunx --bun prettier --write 'tools/**/*.js' 'client/src/**/*.js' 'client/tools/**/*.js' 'client/test/**/*.js' 'server/src/**/*.js' 'server/tools/**/*.js' 'server/test/**/*.js' 'content/src/**/*.js' 'content/test/**/*.js' 'studio/src/**/*.js' 'studio/tools/**/*.js' 'studio/test/**/*.js' 'shared/**/*.js' client/index.html client/style.css client/online.css studio/index.html studio/style.css eslint.config.js package.json client/package.json server/package.json content/package.json studio/package.json"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "acorn": "8.18.0",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "mermaid": "12.0.0",
    "prettier": "3.8.1",
    "vitepress": "1.6.4",
    "vue": "3.5.42"
  }
}
